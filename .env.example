# Copy this file to .env and fill in your own values.
# Never publish .env or share its secrets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Resend: create an API key in your Resend account.
RESEND_API_KEY=re_your_api_key_here
# Must be a sender address allowed by your verified Resend domain, e.g. NU10 Talent Acquisition <interviews@your-verified-domain.com>
EMAIL_FROM=NU10 Talent Acquisition <interviews@your-verified-domain.com>
# Optional: TA notification address
TA_NOTIFICATION_EMAIL=ta@your-company.com

# Local defaults to SQLite. For deployment, use managed PostgreSQL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./nu10_scheduler.db

# Set to your public deployed URL after deployment. No trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:8000
